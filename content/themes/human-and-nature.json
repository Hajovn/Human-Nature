    "sections": [
      {
        "id": "human-and-nature",
        "title": "Manusia dan alam",
        "layout": "split",
        "align": "left",
        "blocks": [
          {
            "type": "text",
            "body": "Manusia adalah bagian dari alam. Kita membutuhkan udara bersih, air, dan makanan, dan alam menyediakannya. Tetapi perubahan iklim mengganggu keseimbangan itu. Apa artinya bagi hewan, tumbuhan — dan bagi kita?"
          }
        ],
        "aside": [
          {
            "type": "placeholder",
            "label": "Gambar akan ditambahkan",
            "ratio": "652 / 229"
          }
        ]
      },
      {
        "id": "human-impact",
        "title": "Dampak manusia terhadap alam",
        "layout": "stack",
        "align": "left",
        "blocks": [
          {
            "type": "text",
            "body": "Kita memiliki dampak yang besar terhadap alam.\n\nTeks untuk bagian halaman ini akan ditambahkan oleh tim Human Nature."
          },
          {
            "type": "tiles",
            "items": [
              {
                "title": "Penggundulan hutan",
                "text": "Deskripsi singkat akan ditambahkan.",
                "linkLabel": "",
                "linkUrl": ""
              },
              {
                "title": "Pertanian dan polusi",
                "text": "Deskripsi singkat akan ditambahkan.",
                "linkLabel": "",
